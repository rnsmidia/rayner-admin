{
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "cenadrop.com.br" }],
      "destination": "/vendas",
      "permanent": false
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.cenadrop.com.br" }],
      "destination": "/vendas",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/admin",                  "destination": "/admin/index.html" },
    { "source": "/admin/",                 "destination": "/admin/index.html" },
    { "source": "/vendas",                 "destination": "/vendas.html" },
    { "source": "/vendas/",                "destination": "/vendas.html" },
    { "source": "/download",               "destination": "/_cenadrop/download/index.html" },
    { "source": "/download/",              "destination": "/_cenadrop/download/index.html" },
    { "source": "/downloadsrt",            "destination": "/_cenadrop/downloadsrt/index.html" },
    { "source": "/downloadsrt/",           "destination": "/_cenadrop/downloadsrt/index.html" },
    { "source": "/manual",                 "destination": "/_cenadrop/manual/index.html" },
    { "source": "/manual/",                "destination": "/_cenadrop/manual/index.html" },
    { "source": "/academyelite",                        "destination": "/academyelite/index.html" },
    { "source": "/academyelite/",                       "destination": "/academyelite/index.html" },
    { "source": "/academyelite/lista-prioritaria",      "destination": "/academyelite/lista-prioritaria.html" },
    { "source": "/academyelite/lista-prioritaria/",     "destination": "/academyelite/lista-prioritaria.html" },
    { "source": "/meta-prompts",  "destination": "/meta-prompts/index.html" },
    { "source": "/meta-prompts/", "destination": "/meta-prompts/index.html" },
    { "source": "/elitedarkacademy",  "destination": "/academyelite/vendas.html" },
    { "source": "/elitedarkacademy/", "destination": "/academyelite/vendas.html" },
    { "source": "/elite-status",  "destination": "/elite-status.html" },
    { "source": "/elite-status/", "destination": "/elite-status.html" },
    { "source": "/api/narrativa-access", "destination": "/api/narrativa-access.js" }
  ]
}
